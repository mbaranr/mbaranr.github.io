<figure class="cover">
  <a class="cover-link" href="{{ include.item.url | relative_url }}">
    {% if include.item.cover %}
      <img alt="{{ include.item.title }} cover" src="{{ include.item.cover | prepend: include.covers | relative_url }}" style="height:200px">
    {% elsif include.item.olid %}
      <img alt="{{ include.item.title }} cover" src="http://covers.openlibrary.org/b/olid/{{ include.item.olid }}-L.jpg?default=false" style="height:200px">
    {% elsif include.item.isbn %}
      <img alt="{{ include.item.title }} cover" src="http://covers.openlibrary.org/b/isbn/{{ include.item.isbn }}-L.jpg?default=false" style="height:200px">
    {% endif %}
    {% if include.item.status %}
      {% assign statuses = 'abandoned,finished,interested,paused,queued,reading,reread' | split: ',' %}
      {% assign status = include.item.status | downcase | strip %}
      {% if statuses contains status %}
        <figcaption class="{{ status }}">{{ status | upcase }}</figcaption>
      {% else %}
        <figcaption class="uncategorized">UNCATEGORIZED</figcaption>
      {% endif %}
    {% else %}
      <figcaption class="uncategorized">UNCATEGORIZED</figcaption>
    {% endif %}
  </a>
</figure>
