---
layout: page
---
{{ content }}

{% if page.collection and page.collection.size > 0 %}
  {% assign collection = site[page.collection] %}
  {% if collection and collection.size > 0 %}
    {% assign wishlist = collection | where_exp: "item", "item.started == blank" %}
    {% assign started = collection | sort: 'started' | reverse | where_exp: "item", "item.started != blank" %}

    {% if wishlist.size > 0 %}
      <h1 id="wish-list">wishlist</h1>
      <ul>
        {% for item in wishlist %}
          {% include book_cover.liquid item=item covers=page.covers %}
        {% endfor %}
      </ul>
    {% endif %}

    {% for item in started %}
      {% assign current_year = item.started | date: '%Y' %}
      {% if current_year != year %}
        {% unless forloop.first %}
          </ul>
        {% endunless %}
        <h1 id="y{{ current_year }}">{{ current_year }}</h1>
        <ul>
          {% assign year = current_year %}
      {% endif %}
      {% include book_cover.liquid item=item covers=page.covers %}
      {% if forloop.last %}
        </ul>
      {% endif %}
    {% endfor %}
  {% endif %}
{% endif %}
